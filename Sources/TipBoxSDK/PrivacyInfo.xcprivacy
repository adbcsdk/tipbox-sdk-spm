<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- TipBox SDK 프라이버시 매니페스트.
         ※ 아래 수집 항목/추적 도메인은 실제 운영 정책에 맞게 검토·수정하세요. -->

    <!-- 광고 식별자(IDFA)를 광고 성과 측정에 사용하므로 추적(tracking) = true -->
    <key>NSPrivacyTracking</key>
    <true/>

    <!-- 추적 목적으로만 접속하는 도메인 목록.
         ※ 기능(functional) API 도메인(api.tip-box.kr 등)은 여기에 넣지 마세요.
            여기에 넣으면 ATT 미허용 시 해당 도메인 연결이 차단되어 기능이 깨집니다.
            순수 광고/어트리뷰션 도메인이 있다면 추가하세요. (Unity 도메인은 UnityAds 매니페스트가 자체 신고) -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- 수집하는 데이터 유형 -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- 기기 식별자: IDFA(ATT 허용 시) / IDFV -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <!-- 사용자 식별자: 매체 userId / 계정 식별자 (리워드 지급·세션 관리용) -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- 전화번호: 계정 로그인(SMS 인증)에 사용. 로그인 기능을 안 쓰면 이 블록을 삭제하세요. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhoneNumber</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!-- Required Reason API 사용 신고 -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- NSUserDefaults: SDK 자체 설정/캐시 저장에 사용 -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
